# Copy this file to .env and fill in your own values.
# Never commit .env — it is ignored by git.

# --- Active in the current phase ---
# On macOS, AirPlay Receiver occupies port 5000. Either turn it off in
# System Settings > General > AirDrop & Handoff, or use another port (e.g. 5001).
PORT=5001
MONGODB_URI=
CLIENT_URL=http://localhost:3000

# --- Authentication (Phase 3) ---
# Generate a strong random secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Planned: media uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Paystack, Phase 7) ---
# Test keys from https://dashboard.paystack.com/#/settings/developers
# The secret key is server-only and must never reach the browser.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional, development only: point the integration at a local Paystack stub.
# Leave unset everywhere else so it defaults to https://api.paystack.co
# PAYSTACK_BASE_URL=

# --- Planned: transactional email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
