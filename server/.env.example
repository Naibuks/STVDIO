# Copy this file to .env and fill in your own values.
# Never commit .env — it is ignored by git.

# --- Active in the current phase ---
# On macOS, AirPlay Receiver occupies port 5000. Either turn it off in
# System Settings > General > AirDrop & Handoff, or use another port (e.g. 5050).
PORT=5000
MONGODB_URI=
CLIENT_URL=http://localhost:3000

# --- Planned: authentication phase ---
JWT_SECRET=

# --- Planned: media uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Planned: payments (Paystack) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Planned: transactional email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
